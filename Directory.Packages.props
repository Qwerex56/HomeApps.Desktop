<Project>
  <!-- Central package versions: projects reference packages without a version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Voice">
    <!-- Microphone through PortAudio (MIT) and the openWakeWord models ("Hey Jarvis") through ONNX Runtime (MIT). -->
    <PackageVersion Include="PortAudioSharp2" Version="1.0.6" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

  <ItemGroup Label="Desktop">
    <!-- The tray app (HomeApps.Desktop). -->
    <PackageVersion Include="Avalonia" Version="11.3.23" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.23" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
