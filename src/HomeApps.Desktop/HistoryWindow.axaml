<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HomeApps.Desktop.HistoryWindow"
        Title="JARVIS: historia rozmów" Width="760" Height="560">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBox x:Name="Search" Width="220" Watermark="Szukaj w rozmowach" />
      <CalendarDatePicker x:Name="DayPicker" Watermark="Dzień" />
      <ComboBox x:Name="ChannelBox" Width="140" SelectedIndex="0">
        <ComboBoxItem Tag="">Wszystkie kanały</ComboBoxItem>
        <ComboBoxItem Tag="voice">Głos</ComboBoxItem>
        <ComboBoxItem Tag="app">Tekst (app)</ComboBoxItem>
        <ComboBoxItem Tag="desktop">Komputer</ComboBoxItem>
      </ComboBox>
      <Button x:Name="Clear" Content="Wyczyść filtry" />
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Wyślij" Margin="8,0,0,0" />
      <TextBox x:Name="Input" Watermark="Napisz do JARVIS-a" AcceptsReturn="False" />
    </DockPanel>
    <ListBox x:Name="Conversations" DockPanel.Dock="Left" Width="200" Margin="0,0,8,0" />
    <ScrollViewer>
      <StackPanel x:Name="Messages" Spacing="6" />
    </ScrollViewer>
  </DockPanel>
</Window>
