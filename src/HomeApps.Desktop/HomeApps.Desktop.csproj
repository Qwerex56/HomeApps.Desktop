<Project Sdk="Microsoft.NET.Sdk">

  <!-- JARVIS in the tray (jarvis-desktop-rework D1): a tray icon with the bridge's states and a global mute hotkey. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HomeApps.Desktop</RootNamespace>
    <AssemblyName>HomeApps.Desktop</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jarvis.VoiceBridge.Core\Jarvis.VoiceBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jarvis.Desktop.Tests" />
  </ItemGroup>

</Project>
