<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JARVIS's ears and mouth on the Mac (jarvis-voice-bridge.md, V0b): the terminal front of Jarvis.VoiceBridge.Core.
    Not a service: run it in a terminal, `dotnet run`.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Jarvis.VoiceBridge</RootNamespace>
    <AssemblyName>jarvis-voice-bridge</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jarvis.VoiceBridge.Core\Jarvis.VoiceBridge.Core.csproj" />
  </ItemGroup>

</Project>
