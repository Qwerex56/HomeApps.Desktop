; JARVIS on the computer (HomeApps jarvis-satellites.md, S-2): the hologram's window and the menu-bar icon.
; The .NET bridge does the listening and talking; this app only starts it (--ipc) and shows what it reports.

config_version=5

[application]

config/name="JARVIS"
config/description="JARVIS na komputerze: hologram i ikona w pasku menu nad mostem .NET."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=true
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 0)
config/icon="res://assets/icons/jarvis.svg"

[display]

window/size/viewport_width=280
window/size/viewport_height=280
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/size/no_focus=true
window/per_pixel_transparency/allowed=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
